{
  "manifest_version": 3,
  "name": "PrivateBit",
  "version": "1.0.0",
  "description": "Fractal Bitcoin wallet. Silent Payments. Payjoin. Local keys.",
  "action": {
    "default_title": "PrivateBit",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "full.html",
  "permissions": ["storage", "alarms", "clipboardWrite"],
  "host_permissions": [
    "https://payjo.in/*",
    "https://pj.bobspacebkk.com/*",
    "https://open-api-fractal.unisat.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
